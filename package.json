{
  "name": "rampworx-backend",
  "version": "1.0.0",
  "description": "Backend API server for RampWorx using Express.js and Sequelize ORM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:setup": "./login_to_postgres.sh"
